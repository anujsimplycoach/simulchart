<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="fw-bold mb-0">My Dashboards</h2>
  <%= link_to "+ New Dashboard", new_dashboard_path, class: "btn btn-dark" %>
</div>

<% if @dashboards.empty? %>
  <div class="text-center py-5 text-muted">
    <h4>No dashboards yet</h4>
    <p>Create your first dashboard to get started.</p>
    <%= link_to "Create Dashboard", new_dashboard_path, class: "btn btn-dark mt-2" %>
  </div>
<% else %>
  <div class="row g-3">
    <% @dashboards.each do |dashboard| %>
      <div class="col-md-4">
        <div class="card shadow-sm border-0">
          <div class="card-body">
            <h5 class="card-title fw-bold"><%= dashboard.name %></h5>
            <p class="text-muted small mb-3">5 charts &bull; Created <%= dashboard.created_at.strftime("%b %d, %Y") %></p>
            <%= link_to "Open", dashboard_path(dashboard), class: "btn btn-dark btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
